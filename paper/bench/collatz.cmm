module main;

fn main() {
    mut total = 0;
    for (mut n = 1; n <= @N@; n = n + 1) {
        mut x = n;
        while (x != 1) {
            if (x % 2 == 0) {
                x = x / 2;
            } else {
                x = 3 * x + 1;
            }
            total += 1;
        }
    }
    print(total);
}
