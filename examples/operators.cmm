module main;
fn main() {
    print(7 + 3);
    print(7 - 10);
    print(7 * 3);
    print(7 / 2);
    print(-7 / 2);
    print(7 % 3);
    print(-7 % 3);
    print(7 % -3);
    print(7.0 / 2.0);
    print(1 + 2.5);
    print(10 / 4.0);
    print(3 < 4);
    print(3 == 3.0);
    print("a" == "b");
    print(!true);
    print(true && false);
    print(true || false);
    print(-(2 + 3) * 2);
}
