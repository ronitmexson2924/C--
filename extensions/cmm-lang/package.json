{
  "name": "cmm-lang",
  "displayName": "C-- Language & File Icons",
  "description": "Rich language support, syntax highlighting, and custom 3D file icons for C-- (.cmm)",
  "version": "0.1.0",
  "publisher": "ronitmexson",
  "engines": {
    "vscode": "^1.70.0"
  },
  "categories": [
    "Programming Languages",
    "Themes"
  ],
  "icon": "icons/logo.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:cmm",
    "workspaceContains:**/*.cmm"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cmm",
        "aliases": [
          "C--",
          "cmm"
        ],
        "extensions": [
          ".cmm"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/cmm-icon.png",
          "dark": "./icons/cmm-icon.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "cmm",
        "scopeName": "source.cmm",
        "path": "./syntaxes/cmm.tmLanguage.json"
      }
    ],
    "iconThemes": [
      {
        "id": "cmm-icons",
        "label": "C-- File Icons",
        "path": "./icons/cmm-icon-theme.json"
      }
    ]
  }
}
