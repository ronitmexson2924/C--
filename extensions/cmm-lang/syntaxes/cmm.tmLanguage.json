{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "C--",
  "scopeName": "source.cmm",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#numbers" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.cmm",
          "match": "//.*$"
        }
      ]
    },
    "strings": {
      "name": "string.quoted.double.cmm",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.cmm",
          "match": "\\\\(n|t|r|\"|\\\\)"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.cmm",
          "match": "\\b(if|else|while|do|for)\\b"
        },
        {
          "name": "keyword.declaration.cmm",
          "match": "\\b(let|mut|fn|module)\\b"
        },
        {
          "name": "support.function.builtin.cmm",
          "match": "\\b(print)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.cmm",
          "match": "\\b(int|float|bool|string)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.boolean.cmm",
          "match": "\\b(true|false)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.cmm",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.cmm",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
          "captures": {
            "1": { "name": "keyword.declaration.cmm" },
            "2": { "name": "entity.name.function.cmm" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.assignment.compound.cmm",
          "match": "(\\+=|-=|\\*=|/=|%=)"
        },
        {
          "name": "keyword.operator.assignment.cmm",
          "match": "(=)"
        },
        {
          "name": "keyword.operator.comparison.cmm",
          "match": "(==|!=|<=|>=|<|>)"
        },
        {
          "name": "keyword.operator.logical.cmm",
          "match": "(&&|\\|\\||!)"
        },
        {
          "name": "keyword.operator.arithmetic.cmm",
          "match": "(\\+|-|\\*|/|%)"
        }
      ]
    }
  }
}
